# ==============================================================================
# Price Bridge — Master Environment Variables Template (.env.example)
# Target Market: United Kingdom (London, GBP £ / pence)
# ==============================================================================
# Copy this file to '.env' and fill in your values.

# ──────────────────────────────────────────────────────────────────────────────
# 1. AI MULTIMODAL INFERENCE APIS (Zero-Download Cloud Inference)
# ──────────────────────────────────────────────────────────────────────────────

# NVIDIA NIM (NVIDIA API Catalog) — 1,000 free credits at https://build.nvidia.com
# Provides zero-download access to open-source vision LLMs (Llama 3.2 Vision / Qwen 2.5 VL)
NVIDIA_API_KEY=nvapi-your-nvidia-key-here
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# Google Gemini API Key — 100% Free tier (1,500 req/day) at https://aistudio.google.com
# Dual-provider fallback for multimodal till receipt OCR and shelf verification
GEMINI_API_KEY=AIzaSy-your-gemini-key-here

# ──────────────────────────────────────────────────────────────────────────────
# 2. BACKEND DATABASE & CACHE
# ──────────────────────────────────────────────────────────────────────────────

# PostgreSQL 16 + PostGIS connection string (Neon Serverless or Render Postgres)
# Format: postgres://<user>:<password>@<host>/<dbname>?sslmode=require
# If left empty, Go backend falls back to in-memory store with 12 London supermarkets.
DATABASE_URL=postgres://pricebridge_user:secret@ep-cool-fog-12345.eu-west-1.neon.tech/pricebridge?sslmode=require

# Redis connection string (optional cache & job queue)
# Format: redis://default:<password>@<host>:<port>
REDIS_URL=redis://default:secret@redis-12345.render.com:6379

# Server HTTP Port (defaults to 8080)
PORT=8080

# Environment mode: development, staging, or production
APP_ENV=development

# ──────────────────────────────────────────────────────────────────────────────
# 3. MOBILE APP API TARGET
# ──────────────────────────────────────────────────────────────────────────────

# Production Render backend URL
BACKEND_BASE_URL=https://pricing-system-4nhl.onrender.com/

# Local emulator test URL:
# BACKEND_BASE_URL=http://10.0.2.2:8080/

# ──────────────────────────────────────────────────────────────────────────────
# 4. SECURITY & AUTH (OAuth2 / JWT)
# ──────────────────────────────────────────────────────────────────────────────

# Secret key used for signing contributor & session JWT tokens
JWT_SECRET=your-random-32-character-secret-key-here

# Google OAuth 2.0 Credentials (for Google Sign-In & Google Tasks import)
# Obtain at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
